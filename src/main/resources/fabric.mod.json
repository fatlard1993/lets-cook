{
  "schemaVersion": 1,
  "id": "lets-cook-justfatlard",
  "version": "${version}",
  "name": "Let's Cook",
  "description": "Rounds out vanilla cooking: smoking as its own craft, cheese, pies, stews and a reason to eat something other than the highest-saturation food in the game.",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/lets-cook"
  },
  "license": "MIT",
  "icon": "assets/lets-cook-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.lets_cook.Main"
    ]
  },
  "mixins": [
    "lets-cook-justfatlard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": "*"
  }
}
