{
  "schemaVersion": 1,
  "id": "lets-cook-justfatlard",
  "version": "${version}",
  "name": "Let's Cook",
  "description": "Rounds out vanilla cooking: smoking, cheese, pies and stews",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/lets-cook"
  },
  "license": "MIT",
  "icon": "assets/lets-cook-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.lets_cook.Main"
    ]
  },
  "mixins": [
    "lets-cook-justfatlard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": ">=15.0.0"
  },
  "suggests": {
    "block-tip": "*",
    "village-quests-justfatlard": "*",
    "knick-knacks-justfatlard": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://github.com/sponsors/fatlard1993"
      }
    }
  }
}
